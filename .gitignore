# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# react-email dev server
.react-email/

# claude code
.claude/

# local database
data/*.db
data/*.db-shm
data/*.db-wal

# typescript
*.tsbuildinfo
next-env.d.ts
lib/mcs/scrape-results.json

.vercel

# Journey verification scratch — generated, and some of it holds secrets
.verify/*.env
.verify/harness.html
.verify/app.jsx

# Local Stripe CLI, downloaded not committed
.tools/

# Local test-mode Stripe credentials — never committed, never in chat
.stripe-test.env
