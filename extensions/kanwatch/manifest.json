{
  "manifest_version": 3,
  "name": "Kanwatch",
  "version": "0.1.1",
  "description": "Sends Kanthink a private, scrubbed record of where your browsing time goes, so Kan can show your day's focus.",
  "incognito": "not_allowed",
  "permissions": ["tabs", "idle", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Kanwatch",
    "default_popup": "popup.html"
  }
}
